# ===================================================================
# StockSense Environment Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit real secrets to source control.
# ===================================================================

# Flask Environment & Security
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=generate_a_random_32_byte_hex_or_alphanumeric_secret_key_here
PORT=5000

# PostgreSQL Database URL
# Format: postgresql+psycopg2://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
# On Render / Supabase: postgresql+psycopg2://user:pass@ep-xyz.render.com:5432/stocksense_db
# Defaults to SQLite for local development: sqlite:///stocksense.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stocksense_db

# Email / SMTP Configuration (for 6-digit OTP Password Reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_secure_smtp_app_password
MAIL_DEFAULT_SENDER=noreply@stocksense.local

# Application Thresholds & OTP Expiry
DEFAULT_LOW_STOCK_THRESHOLD=10
OTP_EXPIRY_MINUTES=10

# Gunicorn Workers (Optional: calculated automatically if omitted)
WEB_CONCURRENCY=4
PYTHON_MAX_THREADS=2
LOG_LEVEL=info
